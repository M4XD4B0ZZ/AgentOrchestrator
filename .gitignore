# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Diagnostics produced by `agent-loop doctor` now live in a per-run directory
# under the per-user application-data root
# (%USERPROFILE%\.agent-orchestrator\diagnostics\doctor\runs\<run-id>\) and
# never inside a repository. This rule stays as a guard against stale or
# hand-made copies — never commit diagnostics.
.diagnostics/

# Test / coverage output
coverage/
.vitest/
*.lcov

# Environment files — never commit these.
.env
.env.*
!.env.example

# Local temporary files
tmp/
temp/
*.tmp
*.log

# Local orchestrator runtime state. ONLY `runtime/` is ignored, and that is a
# product requirement rather than a preference: `startTask` asks Git — with
# `git check-ignore` — whether `.agent-orchestrator/runtime/<taskId>.json` is
# ignored before it writes anything, and refuses with RUNTIME_NOT_IGNORED when
# it is not. Every durable machine-written artefact lives under that one
# directory, delivery evidence included.
#
# The two documents beside it are NOT ignored, and must not be: the repository
# profile is read by the scope gate out of the commit a task was pinned to
# (`git show <basePinnedCommit>:<profile>`), so an uncommitted profile makes
# every task park before its writer ever starts. The task files are the
# repository's own prose for a task, and once the profile is tracked an
# untracked sibling would fail the next workspace preparation with
# SOURCE_WORKTREE_DIRTY.
.agent-orchestrator/runtime/

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Local Claude Code settings. Only this one file — `.claude/` itself is NOT
# ignored, because deliberately versioned repository configuration may live
# there later.
.claude/settings.local.json

# IDE / editor local files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
