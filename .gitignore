# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Diagnostics produced by `agent-loop doctor` now live in the per-user
# application-data root (%USERPROFILE%\.agent-orchestrator\diagnostics\doctor\)
# and never inside a repository. This rule stays as a guard against stale or
# hand-made copies — never commit diagnostics.
.diagnostics/

# Test / coverage output
coverage/
.vitest/
*.lcov

# Environment files — never commit these.
.env
.env.*
!.env.example

# Local temporary files
tmp/
temp/
*.tmp
*.log

# Local orchestrator runtime state (should live outside the repo, but be safe)
.agent-orchestrator/

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# IDE / editor local files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
