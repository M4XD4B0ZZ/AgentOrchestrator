# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Diagnostics produced by `agent-loop doctor` now live in a per-run directory
# under the per-user application-data root
# (%USERPROFILE%\.agent-orchestrator\diagnostics\doctor\runs\<run-id>\) and
# never inside a repository. This rule stays as a guard against stale or
# hand-made copies — never commit diagnostics.
.diagnostics/

# Test / coverage output
coverage/
.vitest/
*.lcov

# Environment files — never commit these.
.env
.env.*
!.env.example

# Local temporary files
tmp/
temp/
*.tmp
*.log

# Local orchestrator runtime state (should live outside the repo, but be safe)
.agent-orchestrator/

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Local Claude Code settings. Only this one file — `.claude/` itself is NOT
# ignored, because deliberately versioned repository configuration may live
# there later.
.claude/settings.local.json

# IDE / editor local files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
